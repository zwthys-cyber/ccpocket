    },
    "You can use Codex today with no extra subscription. CC Pocket helps you set it up on your Mac and connect from your phone." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "追加課金なしで Codex を今日から使えます。CC Pocket が、Mac でのセットアップとスマホ接続を案内します。" } },
