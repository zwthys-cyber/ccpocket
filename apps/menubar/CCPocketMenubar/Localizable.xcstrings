      }
    },
    "Manage your Bridge Server, monitor usage, and connect your mobile device — all from the menu bar." : {
      "localizations" : {
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Bridge Serverの管理、使用状況の確認、モバイル端末との接続 — すべてメニューバーから操作できます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在菜单栏管理 Bridge 服务、查看用量和连接手机。" } }
